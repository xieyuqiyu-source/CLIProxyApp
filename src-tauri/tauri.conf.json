{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CPSwitch",
  "version": "1.1.3",
  "identifier": "com.xieyuqiyu.cpswitch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run prepare:sidecar && npm run prepare:cpm && npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run prepare:cpm && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CPSwitch",
        "width": 430,
        "height": 920,
        "minWidth": 390,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "resources": [
      "resources/sidecar/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
